{
  "name": "presentonika/wordpress-first-party",
  "description": "First-party WordPress plugins for Presentonika",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1 <8.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.8",
    "phpstan/phpstan": "^2.1",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "@php ci/php-lint.php",
    "js-check": "@php ci/js-check.php",
    "artifact-audit": "@php ci/artifact-audit.php",
    "p0-smoke": "@php tests/p0-smoke.php",
    "storage-smoke": "@php tests/storage-provider-smoke.php",
    "vkid-smoke": "@php tests/vkid-linking-smoke.php",
    "phpcs": "phpcs -q",
    "phpstan": "phpstan analyse --no-progress --memory-limit=512M",
    "test": [
      "@lint",
      "@js-check",
      "@artifact-audit",
      "@p0-smoke",
      "@storage-smoke",
      "@vkid-smoke",
      "@phpcs",
      "@phpstan"
    ]
  }
}
